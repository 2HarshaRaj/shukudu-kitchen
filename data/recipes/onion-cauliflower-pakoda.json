  "preparation": [
    {
      "text": "Cut the cauliflower into small florets approximately 2–3 cm wide."
    },
    {
      "lead": "Wash thoroughly and drain completely:",
      "ingredientIds": ["cauliflower"],
      "after": "Spread the florets on a kitchen towel and allow them to dry for around 10 minutes. The florets should not contain excess surface moisture."
    },
    {
      "lead": "Thinly slice and separate the layers:",
      "ingredientIds": ["onion"]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Add to a wide mixing bowl:",
      "ingredientIds": ["cauliflower", "onion", "green-chilli", "ginger", "coriander-leaves", "curry-leaves"]
    },
    {
      "lead": "Add:",
      "ingredientIds": ["kashmiri-chilli-powder", "turmeric-powder", "ajwain", "garam-masala", "salt"],
      "after": "Mix well. Lightly squeeze the onion with the fingers and rest the mixture for 5 minutes so that the onion releases some moisture."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["besan", "rice-flour", "hot-oil"],
      "after": "Mix until the flour coats the onion and cauliflower evenly."
    },
    {
      "lead": "Gradually add:",
      "ingredientIds": ["water"],
      "after": "Start with 60 ml and add up to 20 ml more only when required. The mixture should be thick, rough and sticky enough to hold the vegetables together. It must not become a flowing bajji-style batter."
    },
    {
      "lead": "Heat in a kadai over medium heat:",
      "ingredientIds": ["deep-frying-oil"]
    },
    {
      "text": "Test the oil with a small portion of the mixture. It should rise gradually without immediately becoming dark."
    },
    {
      "text": "Pick up small irregular portions containing both onion and cauliflower and carefully drop them into the oil."
    },
    {
      "text": "Fry around 5–7 pakodas per batch without overcrowding the kadai."
    },
    {
      "text": "Fry over medium heat for approximately 4–6 minutes, turning occasionally, until the pakodas are crisp and deep golden."
    },
    {
      "text": "Remove and drain on a wire rack or absorbent paper."
    },
    {
      "text": "Allow the oil to return to the correct temperature before frying the next batch."
    }
  ],
  "servingSuggestions": [
    "Serve immediately while hot and crisp.",
    "Serve with coconut chutney, mint-coriander chutney or tomato ketchup.",
    "Serve as an evening snack with tea or coffee."
  ],
  "notes": [
    "Untested draft: cook and validate quantity, texture, seasoning and frying time before finalizing.",
    "Keep the cauliflower florets small so that they cook before the coating becomes too dark.",
    "Do not blanch or boil the cauliflower for this version.",
    "Ensure the washed cauliflower is thoroughly drained and surface-dried.",
    "Rice flour helps produce a crisper exterior.",
    "Avoid adding excess water. The mixture should remain thick and irregular rather than smooth or flowing.",
    "High heat may brown the outside before the cauliflower cooks.",
    "Low heat may cause the pakodas to absorb excess oil.",
    "For additional crispness, the pakodas may be fried again for 30–45 seconds over medium-high heat immediately before serving."
  ]
}
