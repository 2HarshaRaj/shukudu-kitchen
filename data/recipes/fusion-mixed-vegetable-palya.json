  "cookingMethod": [
    { "lead": "Heat a pan and add:", "ingredientIds": ["oil"] },
    { "lead": "Add:", "ingredientIds": ["mustard-seeds"], "after": "Let the mustard seeds splutter." },
    { "lead": "Add:", "ingredientIds": ["cumin-seeds", "urad-dal", "chana-dal"], "after": "Fry briefly until the dals start turning light golden." },
    { "lead": "Add:", "ingredientIds": ["curry-leaves", "green-chilli"], "after": "Stir briefly." },
    { "lead": "Add:", "ingredientIds": ["ginger-garlic-paste"], "after": "Fry briefly until the raw smell reduces." },
    { "lead": "Add:", "ingredientIds": ["onion"], "after": "Saute until softened." },
    { "lead": "Add:", "ingredientIds": ["tomato"], "after": "Cook until soft." },
    { "lead": "Add:", "ingredientIds": ["potato", "beans", "carrot", "frozen-peas", "frozen-sweet-corn"], "after": "Mix well." },
    { "lead": "Add:", "ingredientIds": ["turmeric-powder", "red-chilli-powder", "coriander-powder", "salt"], "after": "Mix until the vegetables are evenly coated." },
    { "lead": "Sprinkle only as needed:", "ingredientIds": ["water"], "after": "Do not make the palya watery." },
    { "text": "Cover and cook on low heat until the vegetables are cooked through." },
    { "text": "Open and cook until the moisture evaporates and the palya is dry." },
    { "lead": "Finish with:", "ingredientIds": ["coriander-leaves", "grated-coconut", "lemon-juice"], "after": "Mix gently and switch off the heat." },
