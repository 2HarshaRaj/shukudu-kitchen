  "preparation": [
    {
      "lead": "Soak, drain and dry:",
      "ingredientIds": [
        "potato"
      ],
      "after": "Keep the potato cubes in water for 10–15 minutes, then drain and dry."
    },
    {
      "lead": "Briefly rinse and dry:",
      "ingredientIds": [
        "button-mushroom"
      ],
      "after": "Do not soak the mushrooms; dry well before slicing."
    },
    {
      "lead": "Blanch briefly:",
      "ingredientIds": [
        "broccoli"
      ],
      "after": "Place in hot salted water for 2 minutes and drain."
    },
    {
      "lead": "Prepare the remaining vegetables:",
      "ingredientIds": [
        "beans",
        "carrot",
        "capsicum",
        "baby-corn",
        "frozen-sweet-corn",
        "onion",
        "garlic",
        "spring-onion-greens"
      ],
      "after": "Use the cuts recorded in the ingredient list and keep the vegetables reasonably dry."
    },
    {
      "lead": "Mix the slurry until completely smooth and keep aside:",
      "ingredientIds": [
        "cornflour",
        "slurry-water"
      ],
      "after": "Stir again immediately before adding because cornflour settles."
    },
    {
      "lead": "Measure the cooking and seasoning ingredients:",
      "ingredientIds": [
        "butter",
        "oil",
        "black-pepper-powder",
        "red-chilli-flakes",
        "soy-sauce",
        "chilli-vinegar",
        "salt",
        "gravy-water",
        "reserved-hot-water"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat in the widest available kadai on medium-high heat:",
      "ingredientIds": [
        "oil",
        "butter"
      ]
    },
    {
      "lead": "Add and sauté:",
      "ingredientIds": [
        "garlic"
      ],
      "after": "Cook for 20–30 seconds until aromatic."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "potato",
        "beans",
        "carrot",
        "broccoli"
      ],
      "after": "Stir-fry for approximately 5–6 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "baby-corn",
        "onion",
        "button-mushroom"
      ],
      "after": "Cook on high heat for approximately 5–6 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "capsicum",
        "frozen-sweet-corn"
      ],
      "after": "Stir-fry for approximately 2 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "black-pepper-powder",
        "red-chilli-flakes",
        "soy-sauce",
        "salt"
      ],
      "after": "Mix until evenly distributed."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "gravy-water"
      ],
      "after": "Bring to a gentle simmer for 1–2 minutes."
    },
    {
      "lead": "Stir the prepared cornflour slurry again:",
      "ingredientIds": [
        "cornflour",
        "slurry-water"
      ]
    },
    {
      "text": "Add the slurry gradually while stirring continuously."
    },
    {
      "text": "Cook for only 30–60 seconds, until the liquid becomes a light, glossy and pourable gravy."
    },
    {
      "lead": "Add only if required to loosen the gravy:",
      "ingredientIds": [
        "reserved-hot-water"
      ],
      "after": "Add gradually until the gravy is light and pourable."
    },
    {
      "lead": "Add during the final 20–30 seconds:",
      "ingredientIds": [
        "chilli-vinegar"
      ]
    },
    {
      "text": "Switch off the heat."
    },
    {
      "lead": "Add and mix gently:",
      "ingredientIds": [
        "spring-onion-greens"
      ]
    }
  ],
  "servingSuggestions": [
    "Serve with Garlic Butter Rice as a tested meal combination."
  ],
  "notes": [
    "This revised version intentionally has a light garlic-pepper gravy, not a dry sauté.",
    "The finished gravy should be glossy, pourable and suitable for spooning over or beside Garlic Butter Rice.",
    "Keep the gravy lightly bodied and not watery, but do not make it thick like Manchurian gravy.",
    "Cornflour is used only for light body; add the slurry gradually because mushroom moisture varies.",
    "Use the final reserved hot water to adjust consistency only if the gravy needs loosening.",
    "Use the widest available kadai. If the vegetables are crowded and start steaming heavily, stir-fry them in two batches before combining them for the gravy.",
    "Do not reduce the recipe quantity merely to fit a smaller pan.",
    "Keep the vegetables distinct and slightly crisp rather than soft.",
    "Mushroom remains 200 g in the revised stored 1× recipe and continues to scale normally when a website recipe scale other than 1× is selected.",
    "The revised 1× recipe is intended for 2 people × 2 meals.",
    "Recipe remains in Testing status until the new quantity and gravy consistency are kitchen-tested."
  ]
}
