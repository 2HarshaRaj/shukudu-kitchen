    { "lead": "Prepare the remaining vegetables:", "ingredientIds": ["beans", "carrot", "capsicum", "baby-corn", "frozen-sweet-corn", "onion", "garlic", "spring-onion-greens"], "after": "Use the cuts recorded in the ingredient list and keep the vegetables reasonably dry." },
    { "lead": "Measure the cooking and seasoning ingredients:", "ingredientIds": ["butter", "oil", "black-pepper-powder", "red-chilli-flakes", "soy-sauce", "chilli-vinegar", "salt", "hot-water"] }
  ],
  "cookingMethod": [
    { "lead": "Heat in a wide kadai on medium-high heat:", "ingredientIds": ["oil", "butter"], "after": "Do not cover the kadai at any point." },
    { "lead": "Add and sauté:", "ingredientIds": ["garlic"], "after": "Cook for 20–30 seconds until aromatic." },
    { "lead": "Add:", "ingredientIds": ["potato", "beans", "carrot", "broccoli"] },
    { "text": "Stir-fry for 4–5 minutes." },
    { "lead": "Add:", "ingredientIds": ["baby-corn", "onion", "button-mushroom"] },
    { "text": "Cook on high heat for 4–5 minutes so the mushroom releases moisture without the vegetables boiling." },
    { "lead": "Add:", "ingredientIds": ["capsicum", "frozen-sweet-corn"] },
    { "text": "Stir-fry for around 2 minutes." },
    { "lead": "Add:", "ingredientIds": ["black-pepper-powder", "red-chilli-flakes", "soy-sauce", "salt"] },
    { "text": "Mix and assess the moisture." },
    { "lead": "Add only if the sauté is too dry:", "ingredientIds": ["hot-water"], "after": "Use 3–5 tablespoons as needed; do not automatically add the full amount." },
    { "text": "Toss until the vegetables have a light glossy coating." },
    { "lead": "Add during the final 20–30 seconds:", "ingredientIds": ["chilli-vinegar"] },
    { "text": "Switch off the heat." },
    { "lead": "Add and mix:", "ingredientIds": ["spring-onion-greens"] }
  ],
