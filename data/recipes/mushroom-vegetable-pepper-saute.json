  "preparation": [
    { "lead": "Soak, drain and dry:", "ingredientIds": ["potato"], "after": "Keep the potato cubes in water for 10–15 minutes, then drain and dry." },
    { "lead": "Briefly rinse and dry:", "ingredientIds": ["button-mushroom"], "after": "Do not soak the mushrooms; dry well before slicing." },
