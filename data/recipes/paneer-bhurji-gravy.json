  "preparation": [
    {
      "lead": "Prepare:",
      "ingredientIds": ["onion", "tomatoes", "capsicum", "coriander-leaves"],
      "after": "Finely chop the onion, tomatoes, capsicum, and coriander leaves."
    },
    {
      "lead": "Soften refrigerated paneer:",
      "ingredientIds": ["paneer"],
      "after": "Remove the paneer block from the refrigerator 10–15 minutes before cooking. Place it in comfortably warm water for 5–7 minutes. Do not use boiling-hot water. Remove and gently pat dry."
    },
    {
      "lead": "Crumble:",
      "ingredientIds": ["paneer"],
      "after": "Crumble using clean fingers or a fork. Keep it coarse and grainy with a few small chunks. Do not mash it into a paste."
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat:",
      "ingredientIds": ["oil", "butter", "cumin-seeds"],
      "after": "Saute until the cumin becomes aromatic."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["onion", "ginger-garlic-paste"],
      "after": "Saute over medium heat until the onion becomes golden."
    },
    {
      "lead": "Lower the heat and add:",
      "ingredientIds": ["turmeric-powder", "red-chilli-powder", "cumin-powder", "coriander-powder", "salt", "besan"],
      "after": "Saute for 30–45 seconds until aromatic. Low heat prevents the spices and besan from burning."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["tomatoes"],
      "after": "Cook until completely soft and mushy and the raw smell disappears."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["capsicum"],
      "after": "Saute for 1 minute so it retains a slight bite."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["water"],
      "after": "Mix well, scrape the masala from the bottom, and bring to a gentle simmer."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["paneer"],
      "after": "Fold gently into the gravy."
    },
    {
      "text": "Cover and simmer on low heat for 2 minutes only. Longer cooking may make the paneer firm or chewy."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": ["garam-masala", "kasuri-methi", "coriander-leaves"],
      "after": "Mix gently and switch off the heat."
    },
    {
      "text": "Rest for 2–3 minutes before serving."
    }
  ],
  "servingSuggestions": [
    "Serve hot with chapati, roti, pav, naan or jeera rice.",
    "Add a small splash of hot water while reheating if the besan thickens the gravy too much."
  ],
  "notes": [
    "Besan gives the gravy thickness and body and should be sauteed briefly to remove the raw flavour.",
    "Crumble the paneer coarsely instead of mashing it finely.",
    "Warm-water soaking softens refrigerated paneer and restores some moisture.",
    "The gravy thickens slightly as it rests.",
    "Refrigerate soon after it stops steaming heavily.",
    "Do not leave the cooked paneer gravy on the kitchen slab from afternoon until night.",
    "Reheat only the required portion until steaming throughout.",
    "This is a Draft recipe and should be finalized only after a successful cooking trial."
  ]
}
