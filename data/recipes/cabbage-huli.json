  "preparation": [
    {
      "lead": "Prepare:",
      "ingredientIds": [
        "cabbage"
      ],
      "after": "Remove unwanted outer leaves and the hard core, then chop the 550 g cleaned cabbage into roughly 1.5–2 cm pieces."
    },
    {
      "lead": "Rinse and pressure-cook:",
      "ingredientIds": [
        "toor-dal",
        "turmeric-powder",
        "dal-cooking-water"
      ],
      "after": "Cook until the dal is completely soft, allow the pressure to release, then mash it well. Pressure-cooking duration does not scale."
    },
    {
      "lead": "Measure for the roasted masala:",
      "ingredientIds": [
        "masala-oil",
        "masala-chana-dal",
        "masala-urad-dal",
        "coriander-seeds",
        "methi-seeds",
        "masala-dried-red-chillies",
        "masala-curry-leaves",
        "masala-hing",
        "desiccated-coconut",
        "masala-grinding-water"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "In a large kadai or pot, combine:",
      "ingredientIds": [
        "cabbage",
        "cabbage-cooking-water"
      ],
      "after": "Cover and cook over medium heat for about 8–10 minutes, stirring once or twice, until tender but not mushy."
    },
    {
      "lead": "Heat for the masala:",
      "ingredientIds": [
        "masala-oil"
      ]
    },
    {
      "lead": "Roast on low-medium heat until aromatic and the dals turn golden:",
      "ingredientIds": [
        "masala-chana-dal",
        "masala-urad-dal",
        "coriander-seeds",
        "methi-seeds"
      ]
    },
    {
      "lead": "Add and roast for 30–45 seconds:",
      "ingredientIds": [
        "masala-dried-red-chillies",
        "masala-curry-leaves",
        "masala-hing"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "desiccated-coconut"
      ],
      "after": "Roast on low heat for about 1 minute without allowing the coconut to brown heavily, then cool slightly."
    },
    {
      "lead": "Grind smooth with:",
      "ingredientIds": [
        "masala-grinding-water"
      ],
      "after": "Keep the ground masala ready."
    },
    {
      "lead": "Add to the cooked cabbage:",
      "ingredientIds": [
        "toor-dal",
        "tamarind-paste",
        "jaggery",
        "salt",
        "finishing-water"
      ],
      "after": "Stir in the mashed dal and the ground roasted coconut masala, mix thoroughly, bring to a gentle boil, then simmer uncovered over low-medium heat for 10–12 minutes, stirring occasionally."
    },
    {
      "lead": "Heat for tempering:",
      "ingredientIds": [
        "tempering-oil"
      ]
    },
    {
      "lead": "Splutter:",
      "ingredientIds": [
        "mustard-seeds"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "tempering-dried-red-chilli",
        "tempering-curry-leaves",
        "tempering-hing"
      ],
      "after": "Fry briefly, pour the tempering over the finished huli, mix, and switch off the heat."
    }
  ],
  "servingSuggestions": [
    "Serve hot with plain rice and papad."
  ],
  "notes": [
    "The tested 1× batch started with 670 g whole cabbage and yielded 550 g cleaned usable cabbage after removing unwanted outer leaves and the hard core.",
    "Use 550 g cleaned cabbage as the authoritative 1× scaling base because trimming loss varies between heads.",
    "The tested batch was good overall; 2 teaspoons salt tasted slightly low, so the finalized baseline is 2¼ teaspoons.",
    "Do not overcook the cabbage during the initial 8–10 minute cook because it simmers again after the dal and masala are added."
  ]
}
