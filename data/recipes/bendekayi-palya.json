    },
    {
      "lead": "Trim and cut:",
      "ingredientIds": [
        "bendekayi"
      ],
      "after": "Trim the ends and cut into approximately 1.5 cm pieces."
    },
    {
      "lead": "Prepare:",
      "ingredientIds": [
        "onion",
        "tomato",
        "green-chillies"
      ],
      "after": "Slice or finely chop the onion, finely chop the tomato, and slit the green chillies."
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat a wide kadai and add:",
      "ingredientIds": [
        "oil"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "mustard-seeds"
      ],
      "after": "Allow them to splutter."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "urad-dal"
      ],
      "after": "Fry until light golden."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "curry-leaves",
        "green-chillies",
        "onion"
      ]
    },
    {
      "text": "Saute until the onion softens."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "bendekayi"
      ],
      "after": "Spread it across the kadai."
    },
    {
      "text": "Cook uncovered over medium-high heat for 7-8 minutes."
    },
    {
      "text": "Stir gently only once every 1-2 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "turmeric-powder"
      ]
    },
    {
      "text": "Continue cooking uncovered over medium heat for 6-8 minutes."
    },
    {
      "lead": "Once the bendekayi is mostly cooked and the sticky texture has reduced, add:",
      "ingredientIds": [
        "tomato",
        "red-chilli-powder",
        "coriander-powder",
        "salt"
      ]
    },
    {
      "text": "Cook uncovered for another 5-7 minutes until the tomato softens and coats the bendekayi without forming a watery gravy."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "coconut-powder"
      ]
    },
    {
      "text": "Mix gently and cook for 1-2 minutes."
    },
    {
      "text": "Switch off the heat and leave the palya uncovered for 2 minutes before serving."
    }
  ],
