  "preparation": [
    {
      "lead": "Prepare:",
      "ingredientIds": ["mangalore-southekai"],
      "after": "Keep the skin on, discard the ends and mature seed/core, and cut the usable flesh into roughly 3 cm chunks."
    },
    {
      "lead": "Rinse and pressure-cook:",
      "ingredientIds": ["toor-dal", "turmeric-powder", "dal-cooking-water"],
      "after": "Cook until the dal is soft, allow the pressure to release, then mash it smooth. Pressure-cooking duration does not scale."
    },
    {
      "lead": "Measure for the fresh masala:",
      "ingredientIds": ["fresh-coconut", "masala-oil", "masala-chana-dal", "coriander-seeds", "methi-seeds", "masala-dried-red-chillies", "cumin-seeds", "masala-grinding-water"]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat for the masala:",
      "ingredientIds": ["masala-oil"]
    },
    {
      "lead": "Roast until aromatic without burning:",
      "ingredientIds": ["masala-chana-dal", "coriander-seeds", "methi-seeds", "masala-dried-red-chillies", "cumin-seeds"]
    },
    {
      "lead": "Turn off the heat and add:",
      "ingredientIds": ["fresh-coconut"],
      "after": "Stir the coconut pieces through the roasted spices in the residual heat, then cool completely."
    },
    {
      "lead": "Grind smooth with:",
      "ingredientIds": ["masala-grinding-water"],
      "after": "Keep the ground masala ready."
    },
    {
      "lead": "In a separate pot, combine:",
      "ingredientIds": ["mangalore-southekai", "southekai-cooking-water"],
      "after": "Cook only until partly done. Do not pressure-cook: the skin should become tender while the pieces remain intact and clearly biteable."
    },
    {
      "lead": "Add to the partially cooked southekai:",
      "ingredientIds": ["tamarind-paste", "jaggery", "salt"],
      "after": "Continue cooking briefly so the flavours enter the pieces."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["toor-dal", "finishing-water"],
      "after": "Mix in all the mashed dal."
    },
    {
      "lead": "Stir in the ground masala made from:",
      "ingredientIds": ["fresh-coconut", "masala-chana-dal", "coriander-seeds", "methi-seeds", "masala-dried-red-chillies", "cumin-seeds"],
      "after": "Simmer until the huli is well combined and the southekai is tender but still intact."
    },
    {"lead": "Heat for tempering:", "ingredientIds": ["tempering-oil"]},
    {"lead": "Splutter:", "ingredientIds": ["mustard-seeds"]},
    {
      "lead": "Add:",
      "ingredientIds": ["tempering-dried-red-chilli", "curry-leaves", "hing"],
      "after": "Fry briefly, then pour the tempering over the finished huli."
    }
  ],
  "servingSuggestions": [
    "Serve hot with plain rice as part of a traditional Karnataka lunch."
  ],
  "notes": [
    "The finalized base starts with 850 g whole Mangalore southekai before trimming and targets approximately 600–650 g usable pieces.",
    "This formulation preserves the tested traditional temple-lunch style balance of salt, chilli, sourness, sweetness and thickness.",
    "Cook the southekai separately rather than under pressure so its skin turns tender while the chunks remain intact and clearly biteable."
  ]
