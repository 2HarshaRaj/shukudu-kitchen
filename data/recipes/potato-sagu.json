  "preparation": [
    {
      "lead": "Wash and prepare for pressure-cooking:",
      "ingredientIds": ["potatoes"],
      "after": "Leave them whole for approximately 2 whistles or halve them for approximately 1 whistle. Allow natural pressure release; a knife should slide in easily when they are done. Roughly mash while retaining small chunks. Pressure-cooking duration does not scale."
    },
    {
      "lead": "Slice, chop and grate as specified:",
      "ingredientIds": ["onion", "tomato", "green-chillies", "ginger"]
    },
    {
      "lead": "Prepare for finishing:",
      "ingredientIds": ["coriander-leaves", "lemon"],
      "after": "Chop the coriander leaves and keep the lemon ready for juicing."
    },
    {
      "lead": "Measure separately before cooking:",
      "ingredientIds": ["sagu-water", "slurry-water", "besan"],
      "after": "Keep the water portions separate so the full measured total is used correctly."
    }
  ],
  "cookingMethod": [
    {
      "lead": "Pressure-cook until soft:",
      "ingredientIds": ["potatoes"],
      "after": "Allow natural pressure release, check that a knife slides in easily, then roughly mash while retaining small chunks."
    },
    {
      "lead": "Heat and temper with:",
      "ingredientIds": ["oil", "mustard-seeds", "cumin-seeds", "urad-dal", "chana-dal", "dried-red-chilli", "hing", "curry-leaves"],
      "after": "Let the dals become lightly golden before proceeding."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["ginger", "green-chillies"],
      "after": "Sauté briefly until aromatic."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["onion"],
      "after": "Sauté until slightly softened; deep browning is not required."
    },
    {
      "lead": "Lower the heat and add:",
      "ingredientIds": ["turmeric-powder", "red-chilli-powder", "salt"],
      "after": "Sauté briefly until aromatic without burning the powders."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["tomato"],
      "after": "Cook until soft and mushy."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["potatoes", "sagu-water"],
      "after": "Mix well. Keep the sagu slightly loose because it thickens as it rests."
    },
    {
      "lead": "Make a completely smooth, lump-free slurry with:",
      "ingredientIds": ["besan", "slurry-water"]
    },
    {
      "lead": "Gradually add while stirring continuously:",
      "ingredientIds": ["besan", "slurry-water"],
      "after": "Continuous stirring prevents lumps."
    },
    {
      "text": "Boil for approximately 5 minutes, stirring as needed, until the raw besan smell disappears. Cooking time does not scale."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": ["coriander-leaves", "lemon"],
      "after": "Mix and switch off the heat."
    }
  ],
  "servingSuggestions": [
    "Serve hot with poori or chapati.",
    "Also pairs well with rava idli.",
    "A slightly loose, pourable consistency works particularly well with rava idli and chapati.",
    "Add a small amount of hot water while reheating if the sagu thickens after resting."
  ],
  "notes": [
    "Tested successfully on 29-Apr-2025 with the original 3-medium-potato version, now normalized to 400 g potatoes.",
    "Taste result from the original trial: Excellent. Next-time improvements: None.",
    "Add the besan slurry while stirring continuously to avoid lumps.",
    "Sagu thickens as it cools, so keep it slightly loose while cooking.",
    "For a chunkier sagu, roughly mash rather than completely mashing the potatoes.",
    "For rava idli, somewhat smaller potato pieces work better than large chunks because they coat the idli more evenly.",
    "Natural pressure release helps the potatoes cook evenly without unnecessary breakage.",
    "Practical household rava-idli observation: 500 g MTR rava idli mix yielded 48 idlis in the household idli plates.",
    "A later sagu batch scaled to approximately 1 kg potatoes was almost double the quantity needed for that 500 g / 48-idli batch.",
    "Do not use 1 kg potatoes as the rava-idli default or encode a finalized rava-idli scaling ratio yet; keep this for future calibration."
  ]
