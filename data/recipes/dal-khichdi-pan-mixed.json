    "preparation": [
        {
            "lead": "Rinse:",
            "ingredientIds": [
                "rice",
                "moong-dal"
            ],
            "after": "Rinse until the water runs mostly clear."
        },
        {
            "lead": "Prepare before starting the kadai step:",
            "ingredientIds": [
                "onion",
                "tomato",
                "green-chilli",
                "garlic",
                "coriander-leaves"
            ]
        }
    ],
    "cookingMethod": [
        {
            "lead": "Add to the pressure cooker:",
            "ingredientIds": [
                "rice",
                "moong-dal",
                "frozen-green-peas",
                "water-pressure",
                "turmeric-pressure",
                "salt-pressure",
                "ghee-pressure"
            ]
        },
        {
            "text": "Cook on High/Boil until pressure builds."
        },
        {
            "text": "Reduce to 300 W and cook for 10 minutes."
        },
        {
            "text": "Allow natural pressure release."
        },
        {
            "lead": "Heat in a kadai:",
            "ingredientIds": [
                "oil"
            ]
        },
        {
            "lead": "Add:",
            "ingredientIds": [
                "cumin-seeds"
            ],
            "after": "Let them splutter."
        },
        {
            "lead": "Add:",
            "ingredientIds": [
                "garlic"
            ],
            "after": "Saut\u00e9 until lightly golden."
        },
        {
            "lead": "Add:",
            "ingredientIds": [
                "onion"
            ],
            "after": "Saut\u00e9 until translucent."
        },
        {
            "lead": "Add:",
            "ingredientIds": [
                "green-chilli"
            ],
            "after": "Saut\u00e9 for about 30 seconds."
        },
        {
            "lead": "Add:",
            "ingredientIds": [
                "tomato"
            ],
            "after": "Cook until soft and mushy."
        },
        {
            "lead": "Add:",
            "ingredientIds": [
                "jeera-powder",
                "red-chilli-powder",
                "turmeric-seasoning"
            ],
            "after": "Mix well and saut\u00e9 on low flame for about 30 seconds."
        },
        {
            "lead": "Add the pressure-cooked mixture with:",
            "ingredientIds": [
                "rice",
                "moong-dal",
                "frozen-green-peas"
            ]
        },
        {
            "text": "Add hot water as required to adjust consistency."
        },
        {
            "lead": "Adjust:",
            "ingredientIds": [
                "salt-final"
            ],
            "after": "Taste and balance the seasoning."
        },
        {
            "text": "Simmer for 2\u20133 minutes."
        },
        {
            "lead": "Finish with:",
            "ingredientIds": [
                "coriander-leaves",
                "butter"
            ],
            "after": "Mix gently and switch off the heat."
        }
    ],
    "servingSuggestions": [
        "Serve hot with onion raita, papad or pickle.",
        "Keep the khichdi slightly loose while switching off because it thickens as it rests."
    ],
    "notes": [
        "This is a pan-mixed khichdi, not a one-pot masala khichdi, because the dal-rice mixture is pressure cooked first and then mixed into the kadai masala.",
        "Base rice quantity is 1 rice cup raw rice.",
        "Base dal quantity is 0.5 standard cup moong dal.",
        "Base pressure-cooking water is 3.75 rice cups.",
        "Frozen peas can be kept around 75\u2013100 g based on preference.",
