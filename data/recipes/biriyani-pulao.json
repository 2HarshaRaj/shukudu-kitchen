  "preparation": [
    {
      "lead": "Rinse, soak and drain:",
      "ingredientIds": ["rice"],
      "after": "Soak for 20 minutes, then drain completely before cooking."
    },
    {
      "lead": "Prepare:",
      "ingredientIds": [
        "onions",
        "green-chilli",
        "carrot",
        "potato",
        "french-beans",
        "capsicum",
        "tomato",
        "coriander-leaves",
        "mint-leaves"
      ]
    },
    {
      "lead": "Whisk until smooth:",
      "ingredientIds": ["curd"]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat in a pressure cooker:",
      "ingredientIds": ["ghee", "oil"]
    },
    {
      "lead": "Add:",
      "ingredientIds": ["cumin-seeds", "bay-leaf", "black-pepper", "cloves", "cinnamon", "javitri"],
      "after": "Sauté until aromatic."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["onions", "ginger-garlic-paste", "green-chilli"],
      "after": "Sauté until the onions turn golden brown."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["carrot", "potato", "french-beans", "green-peas", "capsicum", "tomato"],
      "after": "Sauté for 2 minutes, until the vegetables shrink slightly."
    },
    {
      "lead": "Reduce the heat to low and add:",
      "ingredientIds": ["curd"],
      "after": "Mix well."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["turmeric", "red-chilli-powder", "biryani-masala", "salt", "coriander-leaves", "mint-leaves"],
      "after": "Sauté on low heat until aromatic."
    },
    {
      "lead": "Pour in:",
      "ingredientIds": ["water"],
      "after": "Bring to a boil."
    },
    {
      "lead": "Drain and add:",
      "ingredientIds": ["rice"],
      "after": "Mix gently without breaking the grains."
    },
    {
      "text": "Cover the pressure cooker and cook for 2 whistles."
    },
    {
      "text": "Allow the pressure to release naturally, then open the cooker and fluff the rice gently."
    }
  ],
  "servingSuggestions": [
    "Serve hot with raita."
  ],
  "notes": [
    "This Draft recipe is untested and should remain Draft until a cooking trial confirms the quantities and method.",
    "At 1×, 1 rice cup basmati rice equals 1⅓ standard cups; the exact 1.6875 rice cups water equals 2¼ standard cups.",
    "The 1× quantities were doubled from the supplied 0.5-rice-cup adaptation rather than recalculated from the source recipe's 1½-standard-cup batch.",
    "Adapted from Hebbars Kitchen's Biriyani Pulao Recipe: https://hebbarskitchen.com/biriyani-pulao-recipe-10-mins-healthy/"
  ]
