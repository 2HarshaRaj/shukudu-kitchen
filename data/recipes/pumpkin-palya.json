        "pumpkin",
        "turmeric-powder",
        "salt"
      ],
      "after": "Mix gently to coat the pumpkin evenly."
    },
    {
      "lead": "Sprinkle:",
      "ingredientIds": [
        "water"
      ],
      "after": "Cover and cook on low heat for 10-15 minutes, stirring every 4-5 minutes, until the pumpkin is soft but still holds shape."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "fresh-coconut",
        "coriander-leaves"
      ],
      "after": "Mix gently and cook uncovered for 1 minute."
    },
    {
      "text": "Switch off the heat and serve hot."
    }
