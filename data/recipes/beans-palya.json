  "preparation": [
    {
      "text": "Wash the beans thoroughly."
    },
    {
      "lead": "Trim and prepare:",
      "ingredientIds": [
        "beans"
      ],
      "after": "Trim both ends and finely chop the beans into small pieces."
    },
    {
      "lead": "Prepare:",
      "ingredientIds": [
        "onion"
      ],
      "after": "Finely chop the onion."
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat a pan and add:",
      "ingredientIds": [
        "oil"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "mustard-seeds"
      ],
      "after": "Allow the mustard seeds to splutter."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "urad-dal",
        "chana-dal"
      ],
      "after": "Fry until the dals turn light golden."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "dry-red-chilli",
        "curry-leaves"
      ],
      "after": "Stir briefly without burning the chilli."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "onion"
      ],
      "after": "Saute for 2-3 minutes until the onion softens."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "beans",
        "turmeric-powder",
        "salt"
      ],
      "after": "Mix well to coat the beans evenly."
    },
    {
      "lead": "Sprinkle:",
      "ingredientIds": [
        "water"
      ],
      "after": "Cover and cook on low heat for 10-12 minutes, stirring every 3-4 minutes until the beans are tender but still retain a slight bite."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "fresh-coconut"
      ],
      "after": "Mix well and cook uncovered for 1-2 minutes."
    },
    {
      "text": "Switch off the heat and serve hot."
    }
  ],
  "servingSuggestions": [
    "Serve with hot rice and rasam.",
    "Serve as a side dish with sambar rice or curd rice.",
    "Can also be served with chapati."
  ],
  "notes": [
    "Avoid adding too much water to prevent the palya from becoming soggy.",
    "Fresh coconut gives the authentic Karnataka-style flavour.",
    "For extra heat, add green chilli only after adjusting the recipe intentionally."
