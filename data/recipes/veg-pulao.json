  "preparation": [
    {
      "lead": "Wash:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Wash 3–4 times until the water runs clear."
    },
    {
      "lead": "Soak:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Soak for 20 minutes."
    },
    {
      "lead": "Drain:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Drain before cooking."
    }
  ],
  "cookingMethod": [
    {
      "lead": "Grind:",
      "ingredientIds": [
        "coriander-leaves",
        "ginger",
        "garlic",
        "green-chilies",
        "grind-cardamom",
        "grind-cinnamon",
        "grind-cloves",
        "fennel-seeds",
        "grind-water"
      ],
      "after": "Grind to a smooth coriander-only masala paste."
    },
    {
      "lead": "Heat in a pressure cooker:",
      "ingredientIds": [
        "ghee"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "cumin-seeds",
        "bay-leaf",
        "temper-cinnamon",
        "temper-cardamom",
        "temper-cloves",
        "whole-black-pepper"
      ],
      "after": "Sauté until aromatic."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "onion"
      ],
      "after": "Sauté until soft."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "tomato"
      ],
      "after": "Cook until soft and mushy."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "beans",
        "green-peas",
        "carrot",
        "potato",
        "gedde-kosu"
      ],
      "after": "Sauté for 2 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "capsicum"
      ],
      "after": "Sauté for 30–45 seconds."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "ground-masala-paste",
        "salt"
      ],
      "after": "Cook for 2 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "rinse-water"
      ],
      "after": "Mix well."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "water"
      ],
      "after": "Bring to a rolling boil."
    },
    {
      "text": "Taste water; it should be slightly saltier than desired."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Stir gently once."
    },
    {
      "text": "Cover with pressure cooker lid and whistle."
    },
    {
      "text": "Bring pressure on high heat."
    },
    {
      "text": "Once pressure builds, reduce induction to 100°C / 300W and cook for 9 minutes."
    },
    {
      "text": "Switch off and allow pressure to release naturally."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "lemon-juice"
      ],
      "after": "Fluff gently and serve."
    }
  ],
  "servingSuggestions": [
    "Serve with onion tomato raita, plain curd or moong dal.",
    "Serve hot after natural pressure release and gentle fluffing."
  ],
  "notes": [
    "This recipe uses 1 rice cup as the canonical base, equivalent to 1⅓ standard cups because 1 standard cup = 0.75 rice cup.",
    "Pressure cooker total liquid is 1.5 standard cups.",
    "Main water is 1¼ standard cups and rinse water is ¼ standard cup.",
    "Add capsicum late to retain texture.",
    "Natural pressure release is required.",
    "This recipe intentionally uses no pudina or mint."
  ]
}
