    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat the oil.",
      "ingredientIds": [
        "oil"
      ],
      "after": "Heat oil in a rasam pot."
    },
    {
      "lead": "Temper the spices.",
      "ingredientIds": [
        "mustard-seeds",
        "curry-leaves-tempering",
        "hing"
      ],
      "after": "Add mustard seeds, curry leaves and hing. Allow the mustard seeds to splutter."
    },
    {
      "lead": "Fry the ground paste.",
      "ingredientIds": [
        "tomatoes",
        "cumin-seeds",
        "coriander-seeds",
        "black-pepper",
        "garlic",
        "green-chilli",
        "curry-leaves-grinding",
        "fresh-coconut"
      ],
      "after": "Fry for 3–4 minutes until aromatic and the raw smell reduces."
    },
    {
      "lead": "Cook the chopped tomato.",
      "ingredientIds": [
        "tomatoes-chopped"
      ],
      "after": "Cook until soft, mushy and the raw tomato smell is gone."
    },
    {
      "lead": "Simmer the rasam.",
      "ingredientIds": [
        "indira-tamarind-paste",
        "water",
        "salt"
      ],
      "after": "Add Indira tamarind paste, water and salt. Simmer gently for 10–12 minutes; do not boil aggressively."
    },
    {
      "text": "Taste with rice before final adjustment. Adjust salt first, tamarind second and pepper last."
    },
    {
      "lead": "Finish and rest.",
      "ingredientIds": [
        "coriander-garnish"
      ],
      "after": "Finish with coriander leaves. Rest for 5 minutes before serving."
    }
  ],
  "servingSuggestions": [
    "Serve hot with plain rice and ghee.",
    "Serve with papad, potato fry, beans palya, balekai palya or pumpkin palya.",
    "Serve in a cup as a light warming rasam."
  ],
  "notes": [
    "This is a Karnataka-style rustic tomato rasam / light tomato saaru made without cooked dal water.",
    "Pepper is kept moderate because the rasam becomes spicier after resting overnight.",
    "Coriander seeds are slightly higher so the rasam has enough flavour when mixed with rice.",
    "For a richer version, use 1 tablespoon ghee plus 1 tablespoon oil for tempering.",
    "If a single reheated portion needs more punch, crush a little pepper, jeera and garlic, fry briefly in ghee, and add only to that portion.",
    "Taste with rice before increasing spice, because rasam that tastes balanced as a drink can feel mild with rice.",
    "Refrigerate leftovers within 2 hours and reheat only the required portion."
  ]
}
