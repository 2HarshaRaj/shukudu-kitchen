      ],
      "after": "Finely chop."
    },
    {
      "lead": "Slit:",
      "ingredientIds": [
        "green-chillies"
      ]
    },
    {
      "lead": "Rinse and soak:",
      "ingredientIds": [
        "cauliflower"
      ],
      "after": "Soak in hot water with a small pinch of salt for 5 minutes, then drain thoroughly. This preparation water and salt are not part of the measured cooking water or cooking salt."
    }
  ],
  "cookingMethod": [
    {
      "text": "Heat the pressure cooker over medium heat."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "oil",
        "ghee",
        "cumin-seeds",
        "bay-leaf",
        "cinnamon",
        "cloves",
        "green-cardamom"
      ],
      "after": "Sauté for 30–40 seconds, until aromatic."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "onion",
        "green-chillies"
      ],
      "after": "Sauté for 5–6 minutes, until the onion becomes lightly golden."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "ginger-garlic-paste"
      ],
      "after": "Sauté for 1 minute, until the raw smell reduces."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "tomato",
        "salt"
      ],
      "after": "Cook for 4–5 minutes, until the tomatoes become soft and pulpy."
    },
    {
      "text": "Reduce the heat to low."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "turmeric",
        "kashmiri-chilli-powder",
        "coriander-powder",
        "cumin-powder",
        "black-pepper-powder"
      ],
      "after": "Mix and cook for 30 seconds. Use a small splash from the measured cooking water if the masala begins sticking; do not add water beyond the measured amount."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "potato",
        "cauliflower",
        "carrot",
        "green-peas"
      ],
      "after": "Mix until coated with the masala. Sauté for 4 minutes, stirring occasionally."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Fold gently and sauté for 1 minute without breaking the grains."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "water",
        "garam-masala"
      ],
      "after": "Mix gently. The cooking liquid should taste slightly saltier than the intended finished rice."
    },
    {
      "text": "Close the pressure cooker. For induction, bring the cooker towards pressure at medium-high heat. Once pressure begins building, reduce to 100°C / approximately 300 W, cook for 9 minutes, switch off and allow natural pressure release for at least 10 minutes."
    },
    {
      "text": "For a gas stove, cook over medium heat until the first whistle, reduce to low heat and cook for 3 minutes, switch off, then allow natural pressure release."
    },
    {
      "text": "Open the cooker and leave the tehri undisturbed for 5 minutes."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": [
        "lemon-juice",
        "coriander-leaves"
      ],
      "after": "Gently fluff from the sides using a flat spoon."
    }
  ],
  "servingSuggestions": [
    "Serve with plain curd or onion raita.",
    "Serve with cucumber raita, papad or pickle.",
    "Serve sliced onion and lemon on the side."
  ],
  "notes": [
    "Tehri should be yellow, rustic and moderately moist rather than dry and separate like pulao.",
    "Potato is an important part of this recipe and should not be reduced excessively.",
    "Keep the cauliflower florets medium-sized so they do not disintegrate during pressure cooking.",
    "For a slightly richer serving, 1 additional teaspoon of ghee may be added at the table.",
    "Reheat the second meal covered with 1–2 tablespoons of water to prevent drying.",
    "This recipe uses powdered spices rather than the ground masala paste used in Veg Pulao.",
    "The recipe remains Draft until it is cooked and household-tested."
  ]
}
