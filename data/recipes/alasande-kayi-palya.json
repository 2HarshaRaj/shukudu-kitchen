      "ingredientIds": [
        "coconut-powder",
        "fresh-grated-coconut"
      ],
      "after": "Use one option, not both."
    },
    {
      "lead": "Keep ready for grinding:",
      "ingredientIds": [
        "tamarind-paste",
        "jaggery-powder",
        "grinding-water"
      ]
    },
    {
      "lead": "Keep the tempering and cooking ingredients ready:",
      "ingredientIds": [
        "tempering-oil",
        "mustard-seeds",
        "urad-dal",
        "curry-leaves",
        "hing",
        "turmeric-powder",
        "salt",
        "cooking-water"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat a small pan and add:",
      "ingredientIds": [
        "roasting-oil"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "dry-red-chillies",
        "coriander-seeds",
        "cumin-seeds",
        "masala-chana-dal"
      ],
      "after": "Roast over low heat for 2–3 minutes until aromatic and the dal becomes lightly golden."
    },
    {
      "lead": "Add either one:",
      "ingredientIds": [
        "coconut-powder",
        "fresh-grated-coconut"
      ],
      "after": "Use one option, not both. Roast briefly for 30–60 seconds until aromatic; do not burn it."
    },
    {
      "text": "Cool the roasted mixture slightly."
    },
    {
      "lead": "Coarsely grind the roasted mixture with:",
      "ingredientIds": [
        "tamarind-paste",
        "jaggery-powder",
        "grinding-water"
      ],
      "after": "Keep the masala coarse and thick, not a smooth watery paste."
    },
    {
      "lead": "In a kadai, heat:",
      "ingredientIds": [
        "tempering-oil"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "mustard-seeds"
      ],
      "after": "Allow them to splutter."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "urad-dal"
      ],
      "after": "Fry until lightly golden."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "curry-leaves",
        "hing"
      ],
      "after": "Stir briefly."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "alasande-kayi",
        "turmeric-powder",
        "salt",
        "cooking-water"
      ],
      "after": "Mix, cover, and cook over low-medium heat for 12–16 minutes, stirring every 3–4 minutes, until tender rather than very crunchy."
    },
    {
      "text": "If any excess cooking water remains, cook uncovered briefly until the pan is moist but not watery."
    },
    {
      "text": "Add the coarse ground masala."
    },
    {
      "text": "Mix thoroughly and cook uncovered over low heat for 3–5 minutes until the masala coats the beans and the raw moisture reduces."
    },
    {
      "text": "Keep the final palya semi-moist and masala-coated so it can be mixed with plain white rice; do not make it watery like a curry or completely dry like an ordinary beans palya."
    },
    {
      "text": "Switch off the heat and rest for about 5 minutes before serving."
    }
  ],
  "servingSuggestions": [
    "Mix with hot plain white rice.",
    "Serve as a masala palya alongside a regular Karnataka meal."
  ],
  "notes": [
    "Shopping apps may call the vegetable “Beans Lobia”.",
    "This recipe uses the long green cowpea pod, not regular French beans and not dried lobia or black-eyed peas.",
    "This is a reconstructed Sringeri-side inspired recipe and needs a cooking trial.",
    "The expected result is reddish-brown, coarse-masala-coated, and semi-moist.",
    "Use either coconut powder or fresh grated coconut, not both.",
    "Coconut powder is measured by spoon or cup volume, not grams.",
    "Sesame is intentionally not included in the first trial.",
    "Enter the exact vegetable weight when it differs from the 500 g base recipe; the website calculates the scale automatically."
  ]
}
