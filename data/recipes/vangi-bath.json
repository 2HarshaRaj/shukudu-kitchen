  "cookingMethod": [
    {
      "lead": "Cook together:",
      "ingredientIds": [
        "rice",
        "water"
      ],
      "after": "Build pressure, reduce to 100°C / 300 W for 10 minutes and allow natural pressure release. Spread the cooked rice gently so it does not become mushy."
    },
    {
      "lead": "Heat in a wide kadai:",
      "ingredientIds": [
        "oil"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "mustard-seeds",
        "urad-dal",
        "chana-dal",
        "curry-leaves"
      ],
      "after": "Allow the tempering ingredients to sizzle."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "onion"
      ],
      "after": "Sauté until softened."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "brinjal",
        "capsicum",
        "turmeric",
        "salt"
      ],
      "after": "Cook covered until the brinjal is tender while retaining its shape."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "vangi-bath-powder"
      ],
      "after": "Mix on low heat for 1–2 minutes."
    },
    {
      "text": "Add the cooked rice gradually and fold gently until evenly coated."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": [
        "lemon"
      ],
      "after": "Turn off the heat before adding the lemon juice."
    }
  ],
  "servingSuggestions": [
    "Serve with plain curd, cucumber raita or potato chips."
  ],
  "notes": [
    "This version uses 250 g brinjal and 100 g capsicum at the 1 rice cup base.",
