  "preparation": [
    {
      "lead": "Rinse thoroughly until the water runs mostly clear, then soak for 20–30 minutes if time permits:",
      "ingredientIds": [
        "toor-dal",
        "moong-dal"
      ],
      "after": "A 20–30 minute soak is ideal for softer dal and more even cooking. If short on time, soak for 10 minutes; if skipping soaking, keep the same cooking time and check softness after pressure release."
    },
    {
      "lead": "Prepare for pressure cooking:",
      "ingredientIds": [
        "tomato",
        "onion",
        "garlic-pressure"
      ]
    },
    {
      "lead": "Prepare for tempering:",
      "ingredientIds": [
        "garlic-tempering",
        "kasuri-methi",
        "coriander-leaves"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Add to a pressure cooker:",
      "ingredientIds": [
        "toor-dal",
        "moong-dal",
        "tomato",
        "onion",
        "garlic-pressure",
        "bay-leaf",
        "black-cardamom",
        "turmeric",
        "salt",
        "ghee-pressure",
        "water"
      ]
    },
    {
      "text": "Pressure cook for 5 whistles on medium flame. Allow the pressure to release naturally."
    },
    {
      "text": "Mash the cooked dal lightly. Keep it thick enough to coat rice, adding only a little hot water if the dal is too thick."
    },
    {
      "lead": "Heat for tempering:",
      "ingredientIds": [
        "ghee-tempering"
      ]
    },
    {
      "lead": "Add and fry until lightly golden:",
      "ingredientIds": [
        "garlic-tempering"
      ]
    },
    {
      "lead": "Add and let splutter:",
      "ingredientIds": [
        "cumin-seeds"
      ]
    },
    {
      "lead": "Lower the flame and add one after another:",
      "ingredientIds": [
        "kasuri-methi",
        "red-chilli-powder",
        "hing",
        "garam-masala"
      ],
      "after": "Stir briefly for 5–10 seconds and immediately pour over the dal."
    },
    {
      "text": "Simmer for 2 minutes so the tadka flavour spreads into the dal."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": [
        "coriander-leaves"
      ],
      "after": "Taste and adjust salt before serving."
    }
  ],
  "servingSuggestions": [
    "Serve hot with plain rice, jeera rice, chapati or poori.",
    "For rice meals, keep the dal slightly flowing. For poori or chapati, simmer a little longer for a thicker consistency."
  ],
  "notes": [
    "Base quantity is 150 g total dal: 100 g toor dal and 50 g moong dal.",
    "This base works for 2 people across 2 meals when dal and rice are the main meal.",
    "The recipe is adapted from Hebbars Kitchen's Dal Tadka Recipe – Punjabi Dhaba Style, but the base quantity is adjusted to the household portion that worked well.",
    "Salt is intentionally set to 3/4 teaspoon at the 1x base because the earlier smaller version tasted bland with only 1/2 teaspoon.",
    "Crushing kasuri methi between palms before adding improves aroma and reduces blandness.",
    "Use a 3 L pressure cooker comfortably for the 1x base quantity. Add ghee before pressure cooking and cook on medium flame to reduce foaming.",
    "Induction reference: the usual 3-whistle style is about 100°C / 300 W for 10 minutes after pressure builds. For this 5-whistle dal, use about 14–15 minutes at 100°C / 300 W after pressure builds, then natural release."
  ]
}
