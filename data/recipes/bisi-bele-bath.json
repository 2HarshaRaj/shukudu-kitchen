  "preparation": [
    {
      "lead": "Soak:",
      "ingredientIds": [
        "toor-dal"
      ],
      "after": "Soak for 20–30 minutes."
    },
    {
      "lead": "Prepare vegetables and garnish:",
      "ingredientIds": [
        "ginger",
        "onion",
        "carrot",
        "potato",
        "peas",
        "beans",
        "capsicum",
        "gedde-kosu",
        "tomato",
        "coriander-leaves"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "In a pressure cooker, add:",
      "ingredientIds": [
        "toor-dal",
        "rice",
        "pressure-cook-turmeric",
        "pressure-cook-oil",
        "pressure-cook-water"
      ],
      "after": "Bring to a boil uncovered. Close the lid with whistle, reduce to 100°C / 300 W, cook for 10 minutes, and allow pressure to release naturally."
    },
    {
      "lead": "In a large kadai, heat:",
      "ingredientIds": [
        "oil",
        "ghee"
      ]
    },
    {
      "lead": "Temper with:",
      "ingredientIds": [
        "mustard-seeds",
        "dried-red-chilli",
        "hing",
        "peanuts",
        "curry-leaves"
      ],
      "after": "Let the mustard splutter and the peanuts turn lightly aromatic."
    },
    {
      "lead": "Sauté:",
      "ingredientIds": [
        "ginger",
        "onion",
        "carrot",
        "potato",
        "peas",
        "beans",
        "capsicum",
        "gedde-kosu",
        "tomato",
        "vegetable-turmeric"
      ],
      "after": "Add about 1 teaspoon salt from the measured salt and sauté for 2 minutes."
    },
    {
      "lead": "Add and boil covered:",
      "ingredientIds": [
        "boiling-water"
      ],
      "after": "Use 3½ cups first. Boil for 10 minutes at 100–120°C / 600–800 W, until the vegetables are cooked. Keep the remaining 2 cups for final consistency."
    },
    {
      "lead": "Mix separately and add:",
      "ingredientIds": [
        "tamarind-concentrate",
        "tamarind-dilution-water"
      ],
      "after": "Boil for 2 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "bisi-bele-bath-powder",
        "red-chilli-powder",
        "salt"
      ],
      "after": "Use the remaining measured salt here. Cook for 2 minutes so the masala blends into the vegetable base."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "toor-dal",
        "rice"
      ],
      "after": "Mix in the cooked rice-dal mixture. Add the remaining water from the measured boiling water if needed for a semi-thick flowing consistency. Simmer covered for 10 minutes at 90–100°C / 300–500 W."
    },
    {
      "lead": "Fry until golden:",
      "ingredientIds": [
        "cashew",
        "tempering-ghee"
      ]
    },
    {
      "lead": "Finish with:",
      "ingredientIds": [
        "coriander-leaves"
      ],
      "after": "Pour the cashew tempering over the bisi bele bath, mix well, and serve hot."
    }
  ],
  "servingSuggestions": [
    "Serve hot with onion raita, plain curd, khara boondi or papad."
  ],
  "notes": [
    "This version is scaled for 2 people for 2 meals using ½ rice cup rice and ½ rice cup toor dal.",
    "This recipe uses store-bought bisi bele bath powder instead of homemade masala.",
    "If using MTR Bisi Bele Bath Powder, start with 3½ tablespoons if a milder first batch is preferred.",
    "Gedde kosu should be cut into 1–1.5 cm cubes so it cooks evenly with the other vegetables.",
    "Bisi bele bath thickens after cooling; loosen with hot water before reheating or serving leftovers.",
    "Health rating: 4/5."
  ]
}