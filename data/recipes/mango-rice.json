    }
  ],
  "cookingMethod": [
    {
      "lead": "Add to the pressure cooker:",
      "ingredientIds": ["rice", "water"]
    },
    {
      "text": "Build pressure normally on induction."
    },
    {
      "text": "After pressure builds, cook at 300 W for 10 minutes."
    },
    {
      "text": "Let pressure release naturally."
    },
    {
      "text": "Spread the cooked rice on a plate and cool completely."
    },
    {
      "lead": "Heat in a kadai:",
      "ingredientIds": ["oil"]
    },
    {
      "lead": "Add:",
      "ingredientIds": ["mustard-seeds", "urad-dal", "chana-dal", "hing", "curry-leaves"],
      "after": "Let the tempering splutter."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["roasted-peanuts-or-cashews"],
      "after": "Sauté briefly."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["raw-mango", "green-chillies", "turmeric"],
      "after": "Sauté about 1 minute until the mango softens slightly."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["rice", "salt"],
      "after": "Mix gently without breaking the grains."
    },
    {
      "text": "Cover and cook on low heat for 2 minutes."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": ["coconut", "coriander-leaves"],
      "after": "Mix gently."
    },
    {
      "lead": "Taste and add only if needed:",
      "ingredientIds": ["lemon-juice"],
      "after": "Use lemon juice only if the mango is not tangy enough."
    }
  ],
  "servingSuggestions": [
    "Serve hot.",
    "Goes well with curd, onion raita, papad, or potato chips."
  ],
  "notes": [
    "Rice for mixed rice dishes should be slightly firmer than regular plain rice.",
    "For Harsha’s induction method, use 2 rice cups water for 1 rice cup soaked rice.",
    "Spread cooked rice on a plate before mixing so grains stay separate.",
    "Use the 3 mm grater side for mango.",
    "For mild mango, use 1.33 to 1.5 cups grated raw mango; for medium sour mango, use 1.25 to 1.33 cups; for very sour mango, use 1 cup.",
    "Normal store-bought raw mango may be milder than Totapuri; adjust mango and lemon accordingly.",
    "Iron kadai may slightly darken the rice; this is normal.",
    "Coconut powder gives a slightly drier finish than fresh coconut.",
    "Peanuts can be replaced with roasted cashews."
  ]
