  "preparation": [
    {
      "lead": "Prepare for pressure cooking:",
      "ingredientIds": [
        "tomatoes",
        "curry-leaves-pressure",
        "coriander-pressure",
        "water-pressure"
      ]
    },
    {
      "lead": "Prepare for tempering and garnish:",
      "ingredientIds": [
        "garlic",
        "dried-red-chilli",
        "curry-leaves-tempering",
        "coriander-garnish"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Add to a pressure cooker:",
      "ingredientIds": [
        "tomatoes",
        "curry-leaves-pressure",
        "coriander-pressure",
        "water-pressure"
      ],
      "after": "Pressure cook for 2 whistles and allow the pressure to release naturally. Mash the cooked mixture well."
    },
    {
      "lead": "Transfer the mashed mixture to a pot and add:",
      "ingredientIds": [
        "rasam-powder",
        "turmeric",
        "black-pepper-powder",
        "cumin-powder",
        "tamarind-paste",
        "jaggery",
        "hing",
        "salt",
        "water-base"
      ],
      "after": "Bring to a boil, however long that takes, then simmer gently for 2–3 minutes until slightly frothy. Turn off the heat."
    },
    {
      "lead": "Heat for tempering:",
      "ingredientIds": [
        "ghee-or-oil"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "mustard-seeds"
      ],
      "after": "Allow the mustard seeds to splutter."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "cumin-seeds",
        "garlic"
      ],
      "after": "Sauté for 20–30 seconds until the garlic becomes aromatic and lightly golden."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "dried-red-chilli",
        "curry-leaves-tempering"
      ],
      "after": "Let them splutter briefly, then pour the tempering over the rasam."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": [
        "coriander-garnish"
      ],
      "after": "Close the lid immediately and rest for 2–3 minutes before serving."
    }
  ],
  "servingSuggestions": [
    "Serve hot with plain rice, potato fry, beans palya or papad.",
    "It can also be served in a cup as a light, warming soup."
  ],
  "notes": [
    "This is a non-rice recipe, so the website uses generic multiplier controls such as 0.5×, 1× and 1.5×.",
    "The recipe makes about 5 cups of rasam at the 1× base quantity.",
    "Pressure cooking part of the coriander creates a deeper flavour, while fresh coriander added at the end preserves aroma.",
    "Garlic is added only during tempering for a stronger roasted aroma.",
    "If the rasam powder is particularly strong or spicy, begin with a slightly smaller amount and adjust after tasting.",
    "Refrigerate leftovers within 2 hours and reheat only the required portion."
  ]
}
