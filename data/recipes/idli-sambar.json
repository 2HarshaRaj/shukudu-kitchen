  "preparation": [
    {
      "lead": "Rinse and pressure-cook:",
      "ingredientIds": ["toor-dal", "dal-cooking-water"],
      "after": "Cook for 3–4 whistles, allow the pressure to release, then whisk or mash until smooth. Pressure-cooking duration does not scale."
    },
    {
      "lead": "Slice, chop and slit as specified:",
      "ingredientIds": ["onion", "tomato", "carrot", "potato", "beans", "drumstick", "green-chillies", "coriander-leaves"],
      "after": "Keep ready for the sambar."
    },
    {
      "lead": "Measure separately for the fresh masala:",
      "ingredientIds": ["coriander-seeds", "masala-chana-dal", "masala-urad-dal", "masala-dried-red-chillies", "methi-seeds", "masala-curry-leaves", "masala-hing"]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Dry-roast until aromatic without burning:",
      "ingredientIds": ["coriander-seeds", "masala-chana-dal", "masala-urad-dal", "masala-dried-red-chillies", "methi-seeds", "masala-curry-leaves", "masala-hing"],
      "after": "Cool slightly, then grind to a dry powder."
    },
    {"lead": "Heat:", "ingredientIds": ["oil"]},
    {"lead": "Add:", "ingredientIds": ["onion"], "after": "Sauté until softened."},
    {
      "lead": "Add:",
      "ingredientIds": ["tomato", "carrot", "potato", "beans", "drumstick", "salt", "turmeric-powder", "green-chillies", "main-curry-leaves"],
      "after": "Use 1 teaspoon of the measured salt. Stir-fry for about 2 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["vegetable-cooking-water"],
      "after": "Boil until the vegetables are about half-cooked; this took about 5 minutes in the tested batch, but use doneness as the cue."
    },
    {
      "lead": "Add only after the vegetables are partly cooked:",
      "ingredientIds": ["tamarind-paste", "jaggery"],
      "after": "Continue cooking until the vegetables are fully cooked."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["toor-dal", "final-water", "salt", "fresh-masala-powder"],
      "after": "Use all the cooked dal and remaining 1 teaspoon measured salt. Boil for 5–7 minutes, keeping the consistency slightly thin and pourable."
    },
    {"lead": "Heat for tempering:", "ingredientIds": ["coconut-oil"]},
    {"lead": "Splutter:", "ingredientIds": ["mustard-seeds"]},
    {
      "lead": "Add:",
      "ingredientIds": ["tempering-urad-dal", "tempering-dried-red-chilli", "tempering-hing", "tempering-curry-leaves"],
      "after": "Fry briefly, then pour the tempering over the sambar."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": ["coriander-leaves"],
      "after": "Simmer briefly, about 1 minute, then serve."
    }
  ],
  "servingSuggestions": [
    "Serve hot and slightly thin with idli and chutney.",
    "The tested base accompanied 1 kg idli batter with chutney."
  ],
  "notes": [
    "This exact fresh-masala version was cooked and approved as good on 29-Aug-2026.",
    "The fresh masala powder replaces 1½ tablespoons commercial sambar powder.",
    "Keep tiffin sambar slightly thin and pourable.",
    "Add tamarind only after the vegetables are partly cooked so the acidity does not slow softening.",
    "Whisk or mash the dal smooth for the desired hotel-style texture."
  ]
}