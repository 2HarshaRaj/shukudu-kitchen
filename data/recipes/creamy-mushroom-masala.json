  "preparation": [
    {
      "lead": "Briefly rinse or wipe, trim and slice:",
      "ingredientIds": ["button-mushrooms"],
      "after": "Do not soak. Trim only the dry stem ends, dry well, then slice approximately 5–7 mm thick."
    },
    {
      "lead": "Prepare:",
      "ingredientIds": ["onion", "green-chilli"],
      "after": "Finely chop the onion and green chilli."
    },
    {
      "lead": "Blend:",
      "ingredientIds": ["tomatoes"],
      "after": "Blend into a smooth purée."
    },
    {
      "lead": "Chop:",
      "ingredientIds": ["coriander-leaves"],
      "after": "Chop the coriander leaves."
    },
    {
      "lead": "Crush:",
      "ingredientIds": ["kasuri-methi"],
      "after": "Crush between the palms."
    },
    {
      "lead": "Measure before cooking:",
      "ingredientIds": ["fresh-cream", "mushroom-saute-oil", "masala-oil", "cumin-seeds", "turmeric-powder", "kashmiri-chilli-powder", "coriander-powder", "cumin-powder", "garam-masala", "salt", "gravy-water", "reserved-hot-water"],
      "after": "Keep the cream, oils, spices and hot water ready."
    }
  ],
  "cookingMethod": [
    {
      "text": "Heat a broad kadai or wide pan over medium-high heat."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["mushroom-saute-oil", "button-mushrooms"],
      "after": "Sauté uncovered over medium-high heat for approximately 7–9 minutes. Continue until most released water evaporates and the mushrooms have a few light brown spots; transfer to a plate without fully overcooking."
    },
    {
      "text": "Reduce the heat to medium."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["masala-oil", "cumin-seeds"],
      "after": "Cook for approximately 20 seconds."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["onion", "green-chilli"],
      "after": "Sauté for approximately 7–9 minutes, until the onion is soft and light golden."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["ginger-garlic-paste"],
      "after": "Sauté for approximately 1–2 minutes, until the raw aroma disappears."
    },
    {
      "lead": "Reduce the heat to low and add:",
      "ingredientIds": ["turmeric-powder", "kashmiri-chilli-powder", "coriander-powder", "cumin-powder"],
      "after": "Cook for approximately 30 seconds."
    },
    {
      "lead": "Add only if required to prevent sticking or burning:",
      "ingredientIds": ["reserved-hot-water"],
      "after": "Use only as much as needed."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["tomatoes", "salt"],
      "after": "Cook uncovered over medium heat for approximately 8–10 minutes, until the raw smell disappears, the gravy is considerably thicker and a little oil releases around the edges."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["button-mushrooms", "gravy-water"],
      "after": "Mix well and bring to a gentle boil. Partially cover and cook over medium-low heat for approximately 6–8 minutes so the mushrooms absorb the masala."
    },
    {
      "lead": "Reduce to the lowest heat and add:",
      "ingredientIds": ["fresh-cream", "garam-masala", "kasuri-methi"],
      "after": "Mix gently and cook uncovered for approximately 2–3 minutes. Do not allow the gravy to boil vigorously after adding the cream."
    },
    {
      "lead": "Switch off the heat and add:",
      "ingredientIds": ["coriander-leaves"],
      "after": "Rest covered for approximately 5 minutes. The gravy should be creamy and thick enough to scoop with chapati, not thin like a pasta sauce."
    }
  ],
  "servingSuggestions": [
    "Serve with chapati, phulka, roti, naan or jeera rice.",
    "Target yield pending household testing: the 400 g mushroom batch is planned for 2 people × 2 meals with approximately 10–12 medium chapatis in total."
  ],
  "notes": [
    "Use a broad pan so the 400 g mushrooms sauté instead of steaming excessively.",
    "Do not soak mushrooms in water.",
    "Sautéing the mushrooms separately keeps their released water from diluting the onion-tomato masala.",
    "Add the cream only on low heat and do not boil the gravy vigorously afterward.",
    "The gravy thickens slightly while resting.",
    "Use reserved hot water only when necessary.",
    "Refrigerate the dinner portion after it stops steaming heavily.",
    "Reheat only the required portion over low heat with a small splash of water.",
    "Avoid repeatedly heating the whole curry.",
    "The planned 2 people × 2 meals yield is awaiting a real cooking trial."
  ]
}
