  "preparation": [
    {
      "lead": "Wash and soak:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Soak for 20 minutes, then drain."
    },
    {
      "lead": "Prepare:",
      "ingredientIds": [
        "onion",
        "green-chilli",
        "coriander-leaves"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat in a pressure cooker:",
      "ingredientIds": [
        "ghee"
      ]
    },
    {
      "lead": "Add whole spices:",
      "ingredientIds": [
        "bay-leaf",
        "cloves",
        "cinnamon",
        "green-cardamom"
      ],
      "after": "Sauté for 15–20 seconds until aromatic. Do not let the spices burn."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "cumin-seeds"
      ],
      "after": "Allow the cumin seeds to splutter."
    },
    {
      "lead": "Add and sauté:",
      "ingredientIds": [
        "onion",
        "green-chilli"
      ],
      "after": "Sauté for 4–5 minutes until the onion becomes soft and lightly golden. Keep the green chilli optional for a milder batch."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Sauté gently for 30 seconds without breaking the grains."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "water",
        "salt"
      ],
      "after": "Mix once. Close the cooker and build pressure on Boil mode until the pressure indicator rises, then reduce to 300 W for 7 minutes. Turn off heat and allow natural pressure release."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": [
        "coriander-leaves"
      ],
      "after": "Open the cooker, fluff the rice gently and mix in the coriander leaves."
    }
  ],
  "servingSuggestions": [
    "Serve with Punjabi dal tadka.",
    "Pair with potato fry, papad or a simple raita."
  ],
  "notes": [
    "This recipe uses 1 rice cup as the canonical scaling base.",
    "The water ratio is 1.5 rice cups water for 1 rice cup soaked sona masuri rice.",
    "The induction method is based on building pressure on Boil mode until the pressure indicator rises, then cooking at 300 W for 7 minutes.",
    "Onions should be lightly golden, not deeply browned.",
    "For stronger aroma, add an extra 0.5 teaspoon ghee after opening the cooker."
  ]
