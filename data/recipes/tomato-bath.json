  "preparation": [
    {
      "lead": "Rinse and soak:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Soak for 20 minutes."
    },
    {
      "lead": "Prepare:",
      "ingredientIds": [
        "tomatoes",
        "onion",
        "ginger",
        "garlic",
        "green-chillies",
        "coriander-leaves"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat in a pressure cooker:",
      "ingredientIds": [
        "ghee"
      ]
    },
    {
      "lead": "Add whole spices:",
      "ingredientIds": [
        "cumin-seeds",
        "bay-leaf",
        "cinnamon",
        "cloves"
      ],
      "after": "Sauté until aromatic. Keep the flame medium and do not let the spices burn."
    },
    {
      "lead": "Add and sauté for 30–40 seconds:",
      "ingredientIds": [
        "garlic",
        "ginger",
        "green-chillies"
      ],
      "after": "Sauté only until the raw smell fades."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "onion"
      ],
      "after": "Sauté until soft and translucent."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "green-peas"
      ],
      "after": "Sauté for 2 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "tomatoes"
      ],
      "after": "Cook until fully soft and mushy. Use ripe tomatoes and avoid sour or under-ripe tomatoes."
    },
    {
      "lead": "Add powdered spices and salt:",
      "ingredientIds": [
        "turmeric",
        "red-chilli-powder",
        "coriander-powder",
        "cumin-powder",
        "salt"
      ],
      "after": "Sauté until the masala thickens and becomes aromatic. Reduce chilli powder slightly when cooking for a milder batch."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "coriander-leaves"
      ],
      "after": "Mix well."
    },
    {
      "lead": "Pour in and bring to a rolling boil:",
      "ingredientIds": [
        "water",
        "garam-masala"
      ],
      "after": "Add garam masala at the boiling-water stage."
    },
    {
      "lead": "Drain and add:",
      "ingredientIds": [
        "rice"
      ],
      "after": "Mix gently without breaking the grains. Build pressure on the induction cooktop, then reduce to 100°C / 300 W for 10 minutes. Allow the pressure to release naturally."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": [
        "lemon"
      ],
      "after": "Add lemon only after opening the cooker. Fluff gently and mix in the lemon juice."
    }
  ],
  "servingSuggestions": [
    "Serve hot with onion-cucumber raita, plain curd or papad."
  ],
  "notes": [
    "This finalized version uses 1 rice cup as the canonical scaling base.",
    "Standard cup equivalents are calculated automatically for rice and rice-cooking water.",
    "This version is adapted from Hebbars Kitchen and finalized after cooking trials.",
    "Garam masala is added to the boiling-water stage because it gave a better tested result.",
    "Lemon juice is added only after opening the cooker and was preferred in testing.",
    "Salt is structured as a scalable measured ingredient, but can still be adjusted after cooking if needed.",
    "Reduce red chilli powder slightly when serving kids or when a milder batch is needed."
  ]
}
