  "preparation": [
    {
      "lead": "Soak:",
      "ingredientIds": [
        "cashews"
      ],
      "after": "Soak in hot water for 30 minutes, then drain."
    },
    {
      "lead": "Pick and clean:",
      "ingredientIds": [
        "methi-leaves"
      ],
      "after": "Clean the leaves thoroughly."
    },
    {
      "lead": "Chop:",
      "ingredientIds": [
        "methi-leaves"
      ],
      "after": "Finely chop the cleaned leaves."
    },
    {
      "lead": "Slice:",
      "ingredientIds": [
        "onion"
      ]
    },
    {
      "lead": "Slit:",
      "ingredientIds": [
        "green-chillies"
      ]
    },
    {
      "lead": "Keep ready:",
      "ingredientIds": [
        "green-peas"
      ],
      "after": "Use fresh or frozen peas; frozen peas do not need thawing."
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat:",
      "ingredientIds": [
        "masala-oil"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "onion",
        "green-chillies",
        "ginger-garlic-paste"
      ],
      "after": "Saute over medium heat until the onion turns translucent. Do not brown it heavily because the curry should retain a pale, creamy colour."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "cashews"
      ],
      "after": "Saute for about 1 minute."
    },
    {
      "text": "Cool the mixture slightly and grind it into a smooth paste. If moisture is needed to help the blades move, use only a small amount taken from the measured recipe water. Do not add any extra unlisted water."
    },
    {
      "lead": "Heat in a kadai:",
      "ingredientIds": [
        "curry-oil",
        "cumin-seeds"
      ],
      "after": "Let the cumin seeds splutter."
    },
    {
      "text": "Add the prepared masala paste. Saute over medium-low heat until it loses its raw smell and the oil begins separating at the edges. Stir regularly because cashew paste can catch at the bottom."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "methi-leaves"
      ],
      "after": "Saute for 2–3 minutes to reduce the rawness and control bitterness."
    },
    {
      "lead": "Lower the heat and add:",
      "ingredientIds": [
        "water",
        "fresh-cream"
      ],
      "after": "Add only the remaining measured water after accounting for any amount used while grinding. Mix continuously until smooth. Keep the heat low so the cream does not split."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "green-peas",
        "sugar",
        "salt"
      ],
      "after": "Mix, cover and simmer on low to medium-low heat for 8–10 minutes, or until the peas are cooked and the gravy becomes creamy. Stir once or twice to prevent sticking."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "garam-masala"
      ],
      "after": "Mix gently."
    },
    {
      "text": "Check the consistency. Do not introduce additional unlisted water during the first trial; note whether the measured 1 standard cup total needs adjustment next time."
    },
    {
      "text": "Turn off the heat and rest for 2 minutes before serving."
    }
  ],
  "servingSuggestions": [
    "Serve with roti.",
    "Serve with chapati.",
    "Serve with paratha.",
    "Serve with naan.",
    "Serve with Jeera Rice."
  ],
  "notes": [
    "Finely chopping the methi gives a more uniform gravy.",
    "Clean methi thoroughly because fresh leaves may contain soil.",
    "At the 1× base, 65 g cleaned methi leaves is roughly 2 loosely packed standard cups. Use grams as the scaling source of truth because leaf volume varies with packing.",
    "Sauteing methi for 2–3 minutes helps control bitterness.",
    "Blanching is an optional future variation for someone who prefers very low bitterness, but it is not the default method.",
    "Add cream only on low heat to reduce the chance of splitting.",
    "The curry intentionally contains no turmeric or red chilli powder, preserving its pale creamy colour.",
    "Green chillies provide the main heat.",
    "This is adapted from Hebbars Kitchen.",
    "This is a Draft recipe pending household testing."
  ]
}
