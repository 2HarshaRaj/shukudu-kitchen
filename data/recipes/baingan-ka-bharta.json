  "preparation": [
    {
      "lead": "Prepare the brinjal:",
      "ingredientIds": ["brinjal", "roasting-garlic", "green-chillies", "roasting-oil"],
      "after": "Make several deep slits without cutting all the way through. Tuck the garlic cloves and green chillies into the slits, then coat the skin with the roasting oil. Keep the stem attached for turning."
    },
    {
      "lead": "Prepare the masala ingredients:",
      "ingredientIds": ["ginger", "masala-garlic", "onion", "tomatoes", "coriander-leaves", "dried-red-chillies"],
      "after": "Chop and measure everything before cooking. Keep the masala garlic separate from the garlic stuffed into the brinjal."
    }
  ],
  "cookingMethod": [
    {
      "text": "Place the prepared brinjal over a medium-low flame. Rotate it slowly and repeatedly so every side cooks through rather than only charring the skin."
    },
    {
      "text": "Push a skewer or fork into the deepest centre, not just beneath the skin. The flesh must be completely soft with no firm resistance. If the centre is hard, continue cooking and test again."
    },
    {
      "lead": "If direct roasting has charred the outside before the centre softens, transfer the brinjal to a pan and add:",
      "ingredientIds": ["rescue-water"],
      "after": "Cover and cook on low heat until a skewer or fork reaches the deep centre without resistance."
    },
    {
      "text": "Cool until safe to handle. Pull away and discard the burnt peel, stem and any loose char. Retain the soft roasted flesh, stuffed garlic and chillies, then mash them together."
    },
    {
      "lead": "Heat in a kadai:",
      "ingredientIds": ["masala-oil", "cumin-seeds", "dried-red-chillies"],
      "after": "Sauté until the cumin becomes aromatic."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["ginger", "masala-garlic"],
      "after": "Sauté briefly until aromatic without browning the garlic heavily."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["onion"],
      "after": "Cook over medium heat until softened and lightly golden."
    },
    {
      "lead": "Lower the heat and add:",
      "ingredientIds": ["kashmiri-chilli-powder", "coriander-powder"],
      "after": "Stir briefly so the spices do not burn."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["tomatoes", "salt"],
      "after": "Cook until the tomatoes are soft and the masala no longer looks watery."
    },
    {
      "lead": "Fold in:",
      "ingredientIds": ["brinjal"],
      "after": "Mix the mashed roasted flesh through the masala and cook for 3–5 minutes."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": ["garam-masala", "coriander-leaves"],
      "after": "Mix well, check the salt and switch off the heat."
    }
  ],
  "servingSuggestions": [
    "Serve hot as a side dish with an Indian meal."
  ],
  "notes": [
    "This 700 g base is provisional and remains untested; no household yield is confirmed.",
    "Enter the whole raw brinjal weight when it differs from 700 g. The website calculates the scale automatically.",
    "Firm flesh at the deep centre usually means the brinjal needs more cooking; it does not by itself establish spoilage.",
    "While peeling and mashing, inspect the flesh for insects, tunnels, extensive discolouration or an off smell. Discard an affected brinjal rather than mixing it into the bharta."
  ]
