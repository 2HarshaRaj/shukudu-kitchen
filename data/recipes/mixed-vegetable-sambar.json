  "preparation": [
    {
      "lead": "Rinse and pressure-cook:",
      "ingredientIds": [
        "toor-dal",
        "turmeric-powder",
        "dal-cooking-water"
      ],
      "after": "Cook until the dal is completely soft, allow the pressure to release, then mash it well. Pressure-cooking duration does not scale."
    },
    {
      "lead": "Prepare the vegetables as specified:",
      "ingredientIds": [
        "drumstick",
        "sambar-onion",
        "knol-khol",
        "carrot",
        "french-beans",
        "potato",
        "brinjal"
      ],
      "after": "Keep the brinjal separate because it is added later."
    },
    {
      "lead": "Measure separately for the fresh sambar masala:",
      "ingredientIds": [
        "masala-oil",
        "masala-chana-dal",
        "masala-urad-dal",
        "coriander-seeds",
        "methi-seeds",
        "masala-dried-red-chillies",
        "masala-curry-leaves",
        "masala-hing",
        "masala-grinding-water"
      ]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat for the masala:",
      "ingredientIds": [
        "masala-oil"
      ]
    },
    {
      "lead": "Roast on low-medium heat until aromatic and the dals turn golden:",
      "ingredientIds": [
        "masala-chana-dal",
        "masala-urad-dal",
        "coriander-seeds",
        "methi-seeds"
      ]
    },
    {
      "lead": "Add and roast for 30–45 seconds:",
      "ingredientIds": [
        "masala-dried-red-chillies",
        "masala-curry-leaves",
        "masala-hing"
      ],
      "after": "Cool slightly."
    },
    {
      "lead": "Grind smooth with:",
      "ingredientIds": [
        "masala-grinding-water"
      ],
      "after": "Keep the ground fresh sambar masala ready."
    },
    {
      "lead": "In a large pot, combine:",
      "ingredientIds": [
        "drumstick",
        "sambar-onion",
        "knol-khol",
        "carrot",
        "french-beans",
        "potato",
        "vegetable-cooking-water"
      ],
      "after": "Cover and cook over medium heat for about 10–12 minutes, until the vegetables are partly cooked but still hold their shape."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "brinjal"
      ],
      "after": "Cover and continue cooking for about 5–7 minutes, until all the vegetables are tender but intact."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "tamarind-paste",
        "jaggery",
        "salt"
      ],
      "after": "Mix well and simmer uncovered for 4–5 minutes so the raw tamarind flavour cooks out."
    },
    {
      "lead": "Stir in the ground masala prepared from:",
      "ingredientIds": [
        "masala-chana-dal",
        "masala-urad-dal",
        "coriander-seeds",
        "methi-seeds",
        "masala-dried-red-chillies",
        "masala-curry-leaves",
        "masala-hing"
      ],
      "after": "Simmer for 4–5 minutes."
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "toor-dal"
      ],
      "after": "Stir in all the cooked and mashed dal, bring to a gentle boil, then simmer for 8–10 minutes. Keep the finished sambar medium-thick and pourable for mixing with rice."
    },
    {
      "lead": "Heat for tempering:",
      "ingredientIds": [
        "tempering-oil"
      ]
    },
    {
      "lead": "Splutter:",
      "ingredientIds": [
        "mustard-seeds"
      ]
    },
    {
      "lead": "Add:",
      "ingredientIds": [
        "tempering-dried-red-chilli",
        "tempering-curry-leaves",
        "tempering-hing"
      ],
      "after": "Fry briefly, pour the tempering over the finished sambar, mix once, and switch off the heat."
    }
  ],
  "servingSuggestions": [
    "Serve hot with plain rice, ghee and papad.",
    "Pickle or a dry vegetable palya can be served on the side."
  ],
  "notes": [
    "This is a rice-focused mixed vegetable sambar, designed to be more robust and vegetable-heavy than the separate Idli Sambar / Hotel-Style Tiffin Sambar recipe.",
    "The 1× vegetable mix totals 600 g: 100 g drumstick, 100 g peeled sambar onion, 100 g knol-khol, 90 g carrot, 90 g French beans, 80 g potato and 40 g brinjal.",
    "No coconut or packaged sambar powder is used; the freshly roasted and ground masala is the full spice base.",
    "The 100 g sambar onion quantity is peeled weight; roughly 120–130 g unpeeled shallots should usually be enough before trimming and peeling.",
    "The tested 1× batch was approved for 2 people × 4 meals.",
    "Tamarind paste was reduced from 1½ tablespoons to 1¼ tablespoons after tasting because the original batch was slightly more sour than preferred."
  ],
  "householdBase": {
    "people": 2,
    "meals": 4,
    "label": "2 people × 4 meals"
  }
}
