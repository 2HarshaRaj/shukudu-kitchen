  "preparation": [
    {
      "lead": "Rinse and soak:",
      "ingredientIds": ["rice"],
      "after": "Soak for 20 minutes."
    },
    {
      "lead": "Clean and prepare:",
      "ingredientIds": ["methi-bunches"],
      "after": "Separate leaves from the thick lower stems. Keep the tender upper stems, wash thoroughly 2–3 times and chop roughly."
    },
    {
      "lead": "Prepare:",
      "ingredientIds": ["onion", "green-chillies", "coriander-leaves"]
    }
  ],
  "cookingMethod": [
    {
      "lead": "Heat in a pressure cooker:",
      "ingredientIds": ["oil"]
    },
    {
      "lead": "Add whole spices:",
      "ingredientIds": ["mustard-seeds", "cumin-seeds", "cinnamon", "cloves", "bay-leaf"],
      "after": "Fry for 20–30 seconds until aromatic."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["onion", "green-chillies"],
      "after": "Sauté for 4–5 minutes until the onion softens."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["ginger-garlic-paste"],
      "after": "Sauté for 1 minute until the raw smell reduces."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["methi-bunches"],
      "after": "Cook for 3–4 minutes until the leaves wilt and the raw methi smell reduces."
    },
    {
      "lead": "Add powdered spices and balancing ingredients:",
      "ingredientIds": ["turmeric", "garam-masala", "tamarind-paste", "jaggery", "salt"],
      "after": "Mix well and cook for 1 minute."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["water"],
      "after": "Bring to a boil."
    },
    {
      "lead": "Drain and add:",
      "ingredientIds": ["rice"],
      "after": "Mix gently without breaking the grains."
    },
    {
      "text": "Pressure cook for 2 whistles and allow natural pressure release. For induction cooking, build pressure, then cook at 100°C / 300 W for 10 minutes and allow natural pressure release."
    },
    {
      "lead": "Finish with:",
      "ingredientIds": ["coriander-leaves"],
      "after": "Fluff gently and mix after opening the cooker."
    }
  ],
  "servingSuggestions": [
    "Serve hot with plain curd, onion raita, potato chips, happala or a lemon wedge on the side."
  ],
  "notes": [
    "This recipe uses 250 g methi bunches as the practical purchase quantity before cleaning.",
    "After removing thick stems, 250 g methi bunches usually gives enough cleaned leaves and tender stems for 1 rice cup rice.",
    "Use all leaves and only the tender upper stems; discard thick lower stems.",
    "Green chillies, whole spices, garam masala, tamarind paste, jaggery and coriander leaves use recipe-specific scale quantities instead of blind linear scaling.",
    "Jaggery balances the natural bitterness of methi without making the rice bath sweet.",
    "Taste for salt after opening the cooker and adjust if needed."
  ]
}
