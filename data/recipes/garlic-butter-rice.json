  "preparation": [
    {
      "lead": "Prepare the rice:",
      "ingredientIds": ["rice"],
      "after": "Wash 2–3 times, soak for 20 minutes, drain fully and air-dry in a strainer for 20–30 minutes."
    },
    {
      "lead": "Measure for pressure cooking:",
      "ingredientIds": ["water", "rice-cooking-oil", "salt"]
    },
    {
      "lead": "Finely chop:",
      "ingredientIds": ["garlic"]
    },
    {
      "lead": "Separate and chop:",
      "ingredientIds": ["spring-onion-whites", "spring-onion-greens"],
      "after": "Keep the whites and greens separate because they are added at different stages."
    }
  ],
  "cookingMethod": [
    {
      "lead": "Add to the pressure cooker:",
      "ingredientIds": ["rice", "water", "rice-cooking-oil", "salt"],
      "after": "Mix once."
    },
    {
      "text": "Build pressure on the induction cooker."
    },
    {
      "text": "Reduce to 300 W at 100°C and cook until the rice is slightly firm and suitable for later tossing. Keep the exact low-power duration as a testing note until the repeat trial confirms it."
    },
    {
      "text": "Allow natural pressure release."
    },
    {
      "text": "Open, fluff gently, spread on a wide plate and cool before tossing."
    },
    {
      "lead": "In a wide kadai, heat:",
      "ingredientIds": ["tossing-oil", "butter"]
    },
    {
      "lead": "Add and sauté:",
      "ingredientIds": ["garlic"],
      "after": "Cook only until aromatic and lightly golden."
    },
    {
      "lead": "Add and sauté:",
      "ingredientIds": ["spring-onion-whites"],
      "after": "Cook for 30–60 seconds."
    },
    {
      "lead": "Add:",
      "ingredientIds": ["black-pepper-powder", "red-chilli-flakes", "mixed-herbs-or-oregano"]
    },
    {
      "lead": "Add the cooled rice and toss gently:",
      "ingredientIds": ["rice"],
      "after": "Use medium-high heat for 2–3 minutes without breaking the grains. Taste and add more salt only if genuinely needed."
    },
    {
      "lead": "Switch off the heat and finish with:",
      "ingredientIds": ["spring-onion-greens"]
    }
  ],
  "servingSuggestions": [
    "Serve with Mushroom Vegetable Pepper Sauté as a tested meal combination."
  ],
  "notes": [
    "This is not a One Pot rice recipe because the rice is cooked separately, cooled and tossed.",
    "Cooling the rice before tossing reduces sticking and breakage.",
    "Draining and briefly air-drying soaked sona masuri rice helps produce firmer, more separated grains.",
    "Keep garlic lightly golden; dark garlic may become bitter.",
    "Keep the seasoning mild because the vegetable sauté is the stronger component.",
